---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Municipalidad de Cerro Navia — información, trámites y servicios para la comunidad.',
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-municipal.png" />
    <link rel="apple-touch-icon" href="/favicon-municipal.png" />
    <link rel="preload" as="image" href="/logo-cerro-navia.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00132f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Evita el parpadeo al aplicar preferencias de accesibilidad guardadas.
      try {
        var c = localStorage.getItem('cn-contrast')
        var f = localStorage.getItem('cn-font')
        if (c) document.documentElement.setAttribute('data-contrast', c)
        if (f) document.documentElement.setAttribute('data-font', f)
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>

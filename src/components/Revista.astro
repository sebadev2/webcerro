---
import Icon from './Icon.astro'
---

<section class="section" id="revista">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">Revista Cerro Navia</h2>
        <p class="section__lead">La revista municipal con noticias, historias y actividades de la comuna.</p>
      </div>
      <a href="#" class="link-more">Ver todas las ediciones <Icon name="arrow" size={18} /></a>
    </div>

    <div class="revista__grid">
      <article class="revista__item">
        <a href="#" class="revista__media">
          <img src="/img/noticia-1.jpg" alt="Portada de la revista Cerro Navia - Edición 60 años" loading="lazy" />
        </a>
        <div class="revista__body">
          <h3 class="revista__title">
            <a href="#">Revista Cerro Navia - 60 años</a>
          </h3>
          <p class="revista__desc">Edición especial de aniversario con la historia de la comuna, sus vecinos y los hitos más importantes de estos 60 años.</p>
          <span class="link-more revista__more">
            Leer más <Icon name="arrow" size={16} />
          </span>
        </div>
      </article>

      <article class="revista__item">
        <a href="#" class="revista__media">
          <img src="/img/noticia-3.jpg" alt="Portada de la revista Cerro Navia - Edición 59 años" loading="lazy" />
        </a>
        <div class="revista__body">
          <h3 class="revista__title">
            <a href="#">Revista Cerro Navia - 59 años</a>
          </h3>
          <p class="revista__desc">Edición conmemorativa con reportajes sobre el desarrollo comunal, obras destacadas y testimonios de vecinos.</p>
          <span class="link-more revista__more">
            Leer más <Icon name="arrow" size={16} />
          </span>
        </div>
      </article>

      <article class="revista__item">
        <a href="#" class="revista__media">
          <img src="/img/noticia-5.jpg" alt="Portada de la revista Cerro Navia - Edición 58 años" loading="lazy" />
        </a>
        <div class="revista__body">
          <h3 class="revista__title">
            <a href="#">Revista Cerro Navia - 58 años</a>
          </h3>
          <p class="revista__desc">Edición especial con la memoria fotográfica de la comuna, entrevistas a personajes destacados y más.</p>
          <span class="link-more revista__more">
            Leer más <Icon name="arrow" size={16} />
          </span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(48px, 6vw, 72px);
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .section__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .section__lead {
    color: var(--grey-500);
    font-size: 1rem;
    margin: 0;
  }

  .link-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--navy-600);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s var(--ease);
  }

  .link-more:hover {
    color: var(--green);
  }

  .revista__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 24px;
  }

  .revista__item {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .revista__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .revista__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .revista__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .revista__item:hover .revista__media img {
    transform: scale(1.05);
  }

  .revista__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    flex: 1;
  }

  .revista__title {
    font-size: 1.08rem;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .revista__title a {
    color: var(--grey-900);
  }

  .revista__title a:hover {
    color: var(--navy-600);
  }

  .revista__desc {
    font-size: 0.9rem;
    color: var(--grey-500);
    flex: 1;
  }

  .revista__more {
    font-size: 0.85rem;
  }

  @media (max-width: 520px) {
    .revista__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { slides, tramites } from '../data/site'
import Icon from './Icon.astro'
---

<section class="hero" id="inicio" aria-label="Portada" data-hero>
  <div class="hero__slides" data-slides>
    {
      slides.map((s, i) => (
        <article class:list={['slide', `slide--${s.tono}`, { 'is-active': i === 0, 'has-img': s.imagen }]} data-slide>
          <div class="slide__media">
            {
              s.imagen ? (
                <>
                  <img
                    class="slide__photo"
                    src={s.imagen}
                    alt={s.alt ?? ''}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    decoding="async"
                  />
                  {/* Velo para que el texto se lea siempre sobre la imagen */}
                  <span class="slide__scrim" aria-hidden="true" />
                </>
              ) : (
                <span class="slide__scene" aria-hidden="true">
                  <span class="slide__ridge slide__ridge--a" />
                  <span class="slide__ridge slide__ridge--b" />
                  <span class="slide__sun" />
                </span>
              )
            }
          </div>
          <div class="container slide__inner">
            <p class="slide__kicker">{s.kicker}</p>
            {/* Un unico h1: solo el primer slide es el titular de la portada. */}
            {i === 0 ? (
              <h1 class="slide__title">{s.titulo}</h1>
            ) : (
              <h2 class="slide__title">{s.titulo}</h2>
            )}
            <p class="slide__text">{s.texto}</p>
            <div class="slide__cta">
              <a href={s.href} class="btn btn--primary">
                {s.cta}
                <Icon name="arrow" size={18} />
              </a>
              {s.credito && <span class="slide__credit">Foto: {s.credito}</span>}
            </div>
          </div>
        </article>
      ))
    }

    <!-- Controles dentro de .hero__slides: así quedan anclados a la zona del
         slide y no quedan tapados por el panel .quick (que va superpuesto). -->
    <div class="container hero__controls">
      <div class="dots" role="tablist" aria-label="Ir a la diapositiva">
        {
          slides.map((_, i) => (
            <button
              type="button"
              class:list={['dot', { 'is-active': i === 0 }]}
              data-dot={i}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`Diapositiva ${i + 1}`}
            />
          ))
        }
      </div>
      <div class="arrows">
        <button type="button" data-prev aria-label="Anterior">
          <Icon name="chevron" size={20} />
        </button>
        <button type="button" data-next aria-label="Siguiente">
          <Icon name="chevron" size={20} />
        </button>
      </div>
    </div>
  </div>

  <!-- Panel de acceso rápido: patrón de Las Condes, el de mayor valor -->
  <div class="quick">
    <div class="container quick__inner">
      <form class="quick__search" action="#" role="search">
        <label class="visually-hidden" for="hq">¿Qué necesitas hacer?</label>
        <Icon name="search" size={20} />
        <input id="hq" type="search" placeholder="¿Qué necesitas hacer? Ej. renovar licencia de conducir" />
        <button class="btn btn--navy" type="submit">Buscar</button>
      </form>

      <ul class="quick__list">
        {
          tramites.map((t) => (
            <li>
              <a href="#">
                <span class="quick__icon">
                  <Icon name={t.icon} size={20} />
                </span>
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--navy-900);
    isolation: isolate;
  }

  /* ------------------------------ slides ----------------------------- */

  .hero__slides {
    position: relative;
    min-height: clamp(480px, 62vh, 580px);
  }

  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease), visibility 0.6s;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .slide__inner {
    position: relative;
    z-index: 2;
    color: var(--white);
    /* Espacio inferior para el botón y los controles del carrusel */
    padding-block: 48px 72px;
    max-width: var(--max);
  }

  .slide__kicker {
    display: inline-block;
    background: var(--green);
    color: var(--navy-900);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 18px;
  }

  .slide__title {
    font-size: clamp(2rem, 4.6vw, 3.3rem);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 20ch;
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .slide__text {
    max-width: 56ch;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    color: rgba(255, 255, 255, 0.86);
    margin-bottom: 28px;
  }

  .slide__cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .slide__credit {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* -------------------------- imagen de fondo -------------------------- */

  .slide__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La foto es más luminosa que el fondo de marca: se baja para no competir
       con el texto y se tiñe apenas hacia el azul de la comuna. */
    filter: saturate(0.85) brightness(0.72) hue-rotate(-6deg);
  }

  .slide__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(0, 19, 47, 0.94) 0%, rgba(0, 19, 47, 0.72) 42%, rgba(0, 19, 47, 0.18) 100%),
      linear-gradient(to top, rgba(0, 19, 47, 0.6) 0%, transparent 45%);
  }

  .slide.has-img .slide__title,
  .slide.has-img .slide__text {
    text-shadow: 0 1px 12px rgba(0, 19, 47, 0.55);
  }

  /* Paisaje abstracto generado con CSS: sin dependencias de imagen */
  .slide__scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .slide__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .slide--navy .slide__media {
    background: linear-gradient(135deg, #00132f 0%, #0b2450 60%, #143272 100%);
  }

  .slide--verde .slide__media {
    background: linear-gradient(135deg, #05302a 0%, #0b5a4e 60%, #107a68 100%);
  }

  .slide--teal .slide__media {
    background: linear-gradient(135deg, #00201f 0%, #06403c 60%, #0b6157 100%);
  }

  .slide__ridge {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 140%;
    height: 62%;
    background: rgba(0, 19, 47, 0.55);
    clip-path: polygon(0 100%, 0 62%, 18% 26%, 34% 54%, 52% 8%, 70% 46%, 86% 22%, 100% 52%, 100% 100%);
  }

  .slide__ridge--b {
    height: 46%;
    background: rgba(0, 19, 47, 0.8);
    opacity: 0.7;
    clip-path: polygon(0 100%, 0 70%, 24% 34%, 44% 66%, 64% 22%, 82% 58%, 100% 30%, 100% 100%);
  }

  .slide__sun {
    position: absolute;
    top: 16%;
    right: 14%;
    width: clamp(90px, 14vw, 180px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 186, 166, 0.5), transparent 68%);
  }

  /* ----------------------------- controles --------------------------- */

  /* Anclados al borde derecho del contenedor y separados del panel de trámites:
     el texto vive a la izquierda, así que la derecha queda libre y los controles
     no se leen como "pegados" al borde. */
  .hero__controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 46px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dot {
    width: 30px;
    height: 5px;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.4);
    padding: 0;
    transition: background 0.3s var(--ease), width 0.3s var(--ease);
  }

  .dot.is-active {
    background: var(--green);
    width: 46px;
  }

  .dot:hover {
    background: rgba(255, 255, 255, 0.75);
  }

  .dot.is-active:hover {
    background: var(--green);
  }

  .arrows {
    display: flex;
    gap: 8px;
  }

  .arrows button {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(0, 19, 47, 0.28);
    color: var(--white);
    backdrop-filter: blur(4px);
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .arrows button:hover {
    background: var(--green);
    border-color: var(--green);
    color: var(--navy-900);
    transform: translateY(-2px);
  }

  .arrows button:first-child :global(svg) {
    transform: rotate(90deg);
  }

  .arrows button:last-child :global(svg) {
    transform: rotate(-90deg);
  }

  /* ------------------------------ quick ------------------------------ */

  .quick {
    position: relative;
    z-index: 6;
    background: var(--white);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: 0 -8px 40px rgba(0, 19, 47, 0.22);
    margin-top: -32px;
  }

  .quick__inner {
    padding-block: 26px 30px;
  }

  .quick__search {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 2px solid var(--grey-200);
    border-radius: var(--radius-pill);
    padding: 7px 7px 7px 20px;
    max-width: 720px;
    transition: border-color 0.2s var(--ease);
  }

  .quick__search:focus-within {
    border-color: var(--green);
  }

  .quick__search :global(svg) {
    color: var(--grey-500);
    flex-shrink: 0;
  }

  .quick__search input {
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    padding: 10px 0;
    min-width: 0;
  }

  .quick__search input:focus {
    outline: none;
  }

  .quick__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .quick__list a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 16px 9px 9px;
    background: var(--grey-050);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius-pill);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--grey-900);
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease),
      transform 0.2s var(--ease), color 0.2s var(--ease);
  }

  .quick__list a:hover {
    background: var(--green-light);
    border-color: var(--green);
    color: var(--navy-900);
    transform: translateY(-2px);
  }

  .quick__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--grey-200);
    color: var(--navy-600);
    flex-shrink: 0;
  }

  .quick__list a:hover .quick__icon {
    background: var(--green);
    border-color: var(--green);
    color: var(--navy-900);
  }

  @media (max-width: 860px) {
    .hero__controls {
      bottom: auto;
      top: 18px;
      justify-content: center;
    }

    .quick {
      margin-top: 0;
      border-radius: 0;
    }

    .slide__inner {
      padding-block: 72px 40px;
    }
  }

  @media (max-width: 520px) {
    .quick__search .btn {
      padding-inline: 16px;
    }

    .quick__list a {
      font-size: 0.82rem;
      padding: 8px 13px 8px 8px;
    }

    .quick__icon {
      width: 30px;
      height: 30px;
    }
  }
</style>

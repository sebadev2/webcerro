---
import { eventos } from '../data/site'
import Icon from './Icon.astro'
---

<section class="section" id="eventos">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">Calendario de Eventos</h2>
        <p class="section__lead">Actividades y eventos próximos en la comuna.</p>
      </div>
      <a href="#" class="link-more">Ver todos los eventos <Icon name="arrow" size={18} /></a>
    </div>

    <ul class="eventos__list">
      {
        eventos.map((e) => (
          <li class="evento">
            <div class="evento__fecha">
              <b>{e.fecha.dia}</b>
              <span>{e.fecha.mes}</span>
              <i>{e.fecha.anio}</i>
            </div>
            <div class="evento__body">
              <h3 class="evento__title">{e.titulo}</h3>
              <p class="evento__desc">{e.descripcion}</p>
              <div class="evento__meta">
                <span><Icon name="clock" size={14} /> {e.hora}</span>
                <span><Icon name="pin" size={14} /> {e.lugar}</span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(48px, 6vw, 72px);
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .section__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .section__lead {
    color: var(--grey-500);
    font-size: 1rem;
    margin: 0;
  }

  .link-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--navy-600);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s var(--ease);
  }

  .link-more:hover {
    color: var(--green);
  }

  .eventos__list {
    display: grid;
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .evento {
    display: flex;
    gap: 20px;
    padding: 20px;
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .evento:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .evento__fecha {
    display: grid;
    justify-items: center;
    line-height: 1;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--green-light);
    color: var(--navy-900);
    flex-shrink: 0;
    min-width: 70px;
  }

  .evento__fecha b {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .evento__fecha span {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .evento__fecha i {
    font-size: 0.65rem;
    font-style: normal;
    opacity: 0.65;
  }

  .evento__body {
    flex: 1;
  }

  .evento__title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .evento__desc {
    color: var(--grey-500);
    font-size: 0.9rem;
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .evento__meta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--grey-600);
  }

  .evento__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .evento__meta :global(svg) {
    color: var(--teal);
  }

  @media (max-width: 620px) {
    .evento {
      flex-direction: column;
      gap: 12px;
    }

    .evento__fecha {
      flex-direction: row;
      gap: 8px;
      align-items: baseline;
      padding: 8px 12px;
    }

    .evento__fecha b {
      font-size: 1.2rem;
    }
  }
</style>

---
import { noticias, categorias } from '../data/site'
import Icon from './Icon.astro'

const iconos: Record<string, string> = {
  Comunidad: 'users',
  Obras: 'briefcase',
  Cultura: 'book',
  Salud: 'heart',
  Deporte: 'star',
  Seguridad: 'shield',
}
---

<section class="section section--alt" id="noticias">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">Cerro Navia al día</h2>
        <p class="section__lead">Noticias, obras y actividades de la municipalidad.</p>
      </div>
      <a href="#" class="link-more">Ver todas las noticias <Icon name="arrow" size={18} /></a>
    </div>

    <div class="tabs" role="tablist" aria-label="Filtrar noticias por categoría" data-tabs>
      {
        categorias.map((c, i) => (
          <button
            type="button"
            role="tab"
            class:list={['tab', { 'is-active': i === 0 }]}
            data-cat={c}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {c}
          </button>
        ))
      }
    </div>

    <ul class="grid" data-news>
      {
        noticias.map((n) => (
          <li class="card" data-cat={n.categoria}>
            <a href="#" class="card__media">
              <img src={n.imagen} alt={n.alt} loading="lazy" />
            </a>
            <div class="card__body">
              <div class="card__meta">
                <time class="date" datetime="2026-09-08">
                  <b>{n.fecha.dia}</b>
                  <span>{n.fecha.mes}</span>
                  <i>{n.fecha.anio}</i>
                </time>
                <span class="chip">{n.categoria}</span>
              </div>
              <h3 class="card__title">
                <a href="#">{n.titulo}</a>
              </h3>
              <p class="card__text">{n.resumen}</p>
              <span class="link-more card__more">
                Ver más <Icon name="arrow" size={16} />
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="empty" data-news-empty hidden>No hay noticias en esta categoría.</p>
  </div>
</section>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
  }

  .tab {
    padding: 8px 16px;
    border: 1px solid var(--grey-200);
    border-radius: var(--radius-pill);
    background: var(--white);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--grey-700);
    transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .tab:hover {
    border-color: var(--green);
    color: var(--navy-900);
  }

  .tab.is-active {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 24px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .card:hover .card__media img {
    transform: scale(1.05);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    flex: 1;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Bloque de fecha sobredimensionado — patrón de Huechuraba */
  .date {
    display: grid;
    justify-items: center;
    line-height: 1;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    background: var(--green-light);
    color: var(--navy-900);
    flex-shrink: 0;
  }

  .date b {
    font-size: 1.2rem;
    font-weight: 800;
  }

  .date span {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .date i {
    font-size: 0.58rem;
    font-style: normal;
    opacity: 0.65;
  }

  .chip {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--navy-600);
  }

  .card__title {
    font-size: 1.08rem;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .card__title a {
    color: var(--grey-900);
  }

  .card__title a:hover {
    color: var(--navy-600);
  }

  .card__text {
    font-size: 0.9rem;
    color: var(--grey-500);
    flex: 1;
  }

  .card__more {
    font-size: 0.85rem;
  }

  .empty {
    text-align: center;
    color: var(--grey-500);
    padding: 40px 0;
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { documentos, utiles } from '../data/site'
import Icon from './Icon.astro'
---

<!-- Módulo de transmisión del Concejo: patrón de Huechuraba -->
<section class="section section--alt">
  <div class="container">
    <div class="consejo">
      <div class="consejo__player">
        <div class="consejo__screen">
          <span class="consejo__live">
            <i></i>
            En vivo
          </span>
          <button type="button" class="consejo__play" aria-label="Reproducir transmisión">
            <Icon name="play" size={30} />
          </button>
          <p class="consejo__caption">Sesión Extraordinaria N° 11 · Concejo Municipal</p>
        </div>
      </div>

      <div class="consejo__info">
        <h2 class="section__title">Concejo Municipal en vivo</h2>
        <p class="section__lead">
          Sigue la transmisión de cada sesión del concejo y revisa las actas y los acuerdos
          adoptados en la comuna.
        </p>

        <ul class="consejo__list">
          <li><a href="#">Ver transmisiones anteriores</a></li>
          <li><a href="#">Calendario de sesiones</a></li>
          <li><a href="#">Actas y acuerdos del Concejo</a></li>
        </ul>

        <a href="#" class="btn btn--navy">Ver todas las transmisiones <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </div>
</section>

<!-- Documentos oficiales -->
<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="section__title">Documentos y transparencia</h2>
        <p class="section__lead">Planes, cuentas públicas y documentos oficiales de libre acceso.</p>
      </div>
    </div>

    <ul class="docs">
      {
        documentos.map((d) => (
          <li>
            <a href="#" class="doc">
              <span class="doc__icon">
                <Icon name={d.icon} size={22} />
              </span>
              <span class="doc__txt">
                <b>{d.label}</b>
                <small>{d.tipo}</small>
              </span>
              <span class="doc__dl" aria-hidden="true">
                <Icon name="download" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Teléfonos útiles -->
<section class="utiles" aria-labelledby="utiles-t">
  <div class="container">
    <div class="utiles__head">
      <h2 id="utiles-t">
        <Icon name="phone" size={22} />
        Teléfonos útiles
      </h2>
      <p>Números de emergencia y atención para la comunidad.</p>
    </div>

    <ul class="utiles__grid">
      {
        utiles.map((u) => (
          <li>
            <a href={`tel:${u.telefono.replace(/\s/g, '')}`} class="util">
              <span class="util__body">
                <b>{u.entidad}</b>
                <small>{u.detalle}</small>
              </span>
              <span class="util__num">{u.telefono}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ------------------------------ concejo ------------------------------ */

  .consejo {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .consejo__player {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .consejo__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background: linear-gradient(140deg, #00132f 0%, #143272 100%);
    color: var(--white);
  }

  .consejo__screen::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: rgba(0, 19, 47, 0.55);
    clip-path: polygon(0 100%, 0 62%, 24% 24%, 46% 58%, 66% 16%, 84% 54%, 100% 30%, 100% 100%);
  }

  .consejo__live {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--alerta);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
  }

  .consejo__live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--white);
    animation: pulse 1.6s infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  .consejo__play {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border: 0;
    border-radius: 50%;
    background: var(--green);
    color: var(--navy-900);
    transition: transform 0.2s var(--ease), background 0.2s var(--ease);
  }

  .consejo__play:hover {
    transform: scale(1.07);
    background: var(--white);
  }

  .consejo__play :global(svg) {
    margin-left: 4px;
  }

  .consejo__caption {
    position: absolute;
    bottom: 16px;
    left: 20px;
    right: 20px;
    z-index: 2;
    font-size: 0.88rem;
    font-weight: 600;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .consejo__list {
    display: grid;
    gap: 8px;
    margin-block: 20px 26px;
  }

  .consejo__list a {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--grey-700);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .consejo__list a::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
  }

  .consejo__list a:hover {
    color: var(--navy-600);
  }

  /* ------------------------------- documentos ------------------------------- */

  .docs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }

  .doc {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius);
    color: var(--grey-900);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .doc:hover {
    border-color: var(--teal);
    background: var(--grey-050);
  }

  .doc__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--info-bg);
    color: var(--navy-600);
    flex-shrink: 0;
  }

  .doc__txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .doc__txt b {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .doc__txt small {
    font-size: 0.76rem;
    color: var(--grey-500);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .doc__dl {
    color: var(--grey-300);
    flex-shrink: 0;
    transition: color 0.2s var(--ease);
  }

  .doc:hover .doc__dl {
    color: var(--teal-dark);
  }

  /* ------------------------------- útiles ------------------------------- */

  .utiles {
    background: var(--navy-800);
    color: var(--white);
    padding-block: clamp(40px, 5vw, 60px);
  }

  .utiles__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }

  .utiles__head h2 {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .utiles__head h2 :global(svg) {
    color: var(--green);
  }

  .utiles__head p {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }

  .utiles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
  }

  .util {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 15px 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
    color: var(--white);
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .util:hover {
    background: rgba(56, 186, 166, 0.14);
    border-color: var(--green);
  }

  .util__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .util__body b {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .util__body small {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .util__num {
    font-size: 1rem;
    font-weight: 800;
    color: var(--green);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .consejo {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
